# ── rl-trading-live .env.example ────────────────────────────────────────────
# Copy this file to .env and fill in real values. .env is gitignored.
# NEVER commit real credentials. All secrets are read via os.getenv().

# MetaTrader 5 (live trading — Windows machine only)
MT5_LOGIN=YOUR_MT5_LOGIN_HERE
MT5_PASSWORD=YOUR_MT5_PASSWORD_HERE
MT5_SERVER=YOUR_MT5_SERVER_HERE

# Jordan persona (xAI Grok). If unset, Jordan falls back to hardcoded one-liners.
GROK_API_KEY=YOUR_GROK_API_KEY_HERE

# Telegram alerts (optional). If unset, Telegram alerts are skipped silently.
TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN_HERE
TELEGRAM_CHAT_ID=YOUR_TELEGRAM_CHAT_ID_HERE
